            "id": "1763903316672",
            "alias": "Charles extended chore mode timeout",
            "description": "Timeout Charles extended chore mode after configured hours and remove all minutes accumulated during the session.",
            "triggers": [
              {
                "trigger": "time_pattern",
                "minutes": "/1"
              }
            ],
            "conditions": [
