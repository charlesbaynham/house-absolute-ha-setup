          "config": {
            "id": "1762500000002",
            "alias": "Back door - pause heating while open",
            "description": "Turn off all TRV heating while the back door is open; restore the rooms that were heating when it closes.",
            "triggers": [
              {
                "trigger": "state",
                "entity_id": "binary_sensor.backdoor_sensor_contact",
                "to": "on",
                "id": "opened"
              },
              {
                "trigger": "state",
                "entity_id": "binary_sensor.backdoor_sensor_contact",
                "to": "off",
                "id": "closed"
              }
            ],
            "conditions": [],
            "actions": [
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "trigger",
                        "id": "opened"
                      },
                      {
                        "condition": "state",
                        "entity_id": "input_boolean.back_door_heating_paused",
                        "state": "off"
                      }
                    ],
                    "sequence": [
                      {
                        "variables": {
                          "heating": "{{ [\n     'climate.living_room_trv_pid_controller',\n     'climate.master_bedroom_trv_pid_controller',\n     'climate.bedroom_trv_pid_controller'\n   ] | select('is_state', 'heat') | list }}"
                        }
                      },
                      {
                        "action": "input_text.set_value",
                        "target": {
                          "entity_id": "input_text.back_door_heating_resume"
                        },
                        "data": {
                          "value": "{{ heating | join(',') }}"
                        }
                      },
                      {
                        "action": "input_boolean.turn_on",
                        "target": {
                          "entity_id": "input_boolean.back_door_heating_paused"
                        }
                      },
                      {
                        "action": "climate.turn_off",
                        "target": {
                          "entity_id": [
                            "climate.living_room_trv_pid_controller",
                            "climate.master_bedroom_trv_pid_controller",
                            "climate.bedroom_trv_pid_controller"
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "conditions": [
                      {
                        "condition": "trigger",
                        "id": "closed"
                      },
                      {
                        "condition": "state",
                        "entity_id": "input_boolean.back_door_heating_paused",
                        "state": "on"
                      }
                    ],
                    "sequence": [
                      {
                        "variables": {
                          "resume": "{{ states('input_text.back_door_heating_resume').split(',')\n   | select('match', 'climate\\.') | list }}",
                          "rooms": {
                            "climate.living_room_trv_pid_controller": {
                              "apply": "automation.living_room_trv_apply_smart_mode",
                              "boost": "input_boolean.boost_mode_living_room",
                              "valve": "input_number.living_room_trv_valve_position"
                            },
                            "climate.master_bedroom_trv_pid_controller": {
                              "apply": "automation.master_bedroom_trv_apply_smart_mode",
                              "boost": "input_boolean.boost_mode_master_bedroom",
                              "valve": "input_number.master_bedroom_trv_valve_position"
                            },
                            "climate.bedroom_trv_pid_controller": {
                              "apply": "automation.bedroom_trv_apply_smart_mode",
                              "boost": "input_boolean.boost_mode_bedroom",
                              "valve": "input_number.bedroom_trv_valve_position"
                            }
                          }
                        }
                      },
                      {
                        "repeat": {
                          "for_each": "{{ resume }}",
                          "sequence": [
                            {
                              "action": "climate.set_hvac_mode",
                              "target": {
                                "entity_id": "{{ repeat.item }}"
                              },
                              "data": {
                                "hvac_mode": "heat"
                              }
                            },
                            {
                              "choose": [
                                {
                                  "conditions": [
                                    {
                                      "condition": "template",
                                      "value_template": "{{ is_state(rooms[repeat.item].boost, 'on') }}"
                                    }
                                  ],
                                  "sequence": [
                                    {
                                      "delay": "00:00:01"
                                    },
                                    {
                                      "action": "input_number.set_value",
                                      "target": {
                                        "entity_id": "{{ rooms[repeat.item].valve }}"
                                      },
                                      "data": {
                                        "value": 100
                                      }
                                    }
                                  ]
                                }
                              ],
                              "default": [
                                {
                                  "action": "automation.trigger",
                                  "target": {
                                    "entity_id": "{{ rooms[repeat.item].apply }}"
                                  },
                                  "data": {
                                    "skip_condition": true
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      },
                      {
                        "action": "input_boolean.turn_off",
                        "target": {
                          "entity_id": "input_boolean.back_door_heating_paused"
                        }
                      }
                    ]
                  }
                ]
              }
            ],
            "mode": "queued",
            "max": 5
          },
