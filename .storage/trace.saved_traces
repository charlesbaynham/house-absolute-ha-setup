            "variables": {
              "thermostat_value": "input_number.master_bedroom_trv_valve_position",
              "max_valve_opening": "number.trv_master_bedroom_valve_opening_degree",
              "max_valve_closing": "number.trv_master_bedroom_valve_closing_degree",
              "min_step": 3,
              "value_valid": "{{ states(thermostat_value) | is_number }}",
              "demand": "{{ [[states(thermostat_value) | float(0), 0] | max, 100] | min }}",
              "at_edge": "{{ demand <= 0 or demand >= 100 }}",
              "target_closing": "{{ (100 - demand) | round(0) | int }}",
              "target_opening": "{{ ([demand + 5, 100] | min) | round(0) | int }}",
              "write_closing": "{% set cur = states(max_valve_closing) | float(none) %} {{ cur is none or (cur != target_closing if at_edge\n   else (cur - target_closing) | abs >= (min_step | float(3))) }}",
              "write_opening": "{% set cur = states(max_valve_opening) | float(none) %} {{ cur is none or (cur != target_opening if at_edge\n   else (cur - target_opening) | abs >= (min_step | float(3))) }}"
            },
            "triggers": [
