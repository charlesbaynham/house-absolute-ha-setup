                  "media_player_entity_id": "media_player.living_room_speaker",
                  "message": "{% set timeout_hours = states('input_number.extended_chore_timeout_hours') | float(6) %} Extended chore mode timed out for Gaby after {{ timeout_hours }} hours. Session minutes have been removed."
                },
                "target": {
