          "config": {
            "id": "1763903316671",
            "alias": "Gaby extended chore mode timeout warning",
            "description": "Warn 30 minutes before Gaby extended chore mode times out. Extended mode timeout is configurable via input_number.extended_chore_timeout_hours.",
            "triggers": [
              {
                "trigger": "time_pattern",
                "minutes": "/1"
              }
            ],
            "conditions": [
              {
                "condition": "state",
                "entity_id": "input_boolean.extended_chore_mode_gaby",
                "state": "on"
              },
              {
                "condition": "template",
                "value_template": "{% set start_time = states('input_datetime.extended_chore_start_gaby') %} {% if start_time not in ['unknown', 'unavailable', ''] %}\n  {% set start = start_time | as_datetime | as_local %}\n  {% set elapsed_minutes = ((now() - start).total_seconds() / 60) | int %}\n  {% set timeout_hours = states('input_number.extended_chore_timeout_hours') | float(6) %}\n  {% set timeout_minutes = (timeout_hours * 60) | int %}\n  {% set warning_minutes = timeout_minutes - 30 %}\n  {{ elapsed_minutes >= warning_minutes and elapsed_minutes < timeout_minutes }}\n{% else %}\n  false\n{% endif %}\n"
              }
            ],
            "actions": [
              {
                "action": "tts.speak",
                "metadata": {},
                "data": {
                  "cache": true,
                  "media_player_entity_id": "media_player.living_room_speaker",
                  "message": "Warning: Gaby extended chore mode will timeout in 30 minutes. Press the button to save your progress."
                },
                "target": {
                  "entity_id": "tts.google_translate_en_com"
                }
              },
              {
                "action": "script.flash_kitchen_surface_lights",
