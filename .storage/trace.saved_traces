          "config": {
            "id": "1740000000003",
            "alias": "Master bedroom TRV - apply smart mode",
            "description": "Smart mode on: PID control. Smart mode off: PID stopped and valve parked at the user-set parked position. Re-applied on startup and when boost ends. Skipped during boost.",
            "triggers": [
              {
                "trigger": "state",
                "entity_id": "input_boolean.smart_mode_master_bedroom"
              },
              {
                "trigger": "state",
