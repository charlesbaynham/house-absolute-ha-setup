            "id": "1763903316670",
            "alias": "Charles extended chore mode timeout warning",
            "description": "Warn 30 minutes before Charles extended chore mode times out. Extended mode timeout is configurable via input_number.extended_chore_timeout_hours.",
            "triggers": [
              {
                "trigger": "time_pattern",
                "minutes": "/1"
              }
            ],
            "conditions": [
              {
                "condition": "state",
                "entity_id": "input_boolean.extended_chore_mode_charles",
                "state": "on"
              },
              {
                "condition": "template",
                "value_template": "{% set start_time = states('input_datetime.extended_chore_start_charles') %} {% if start_time not in ['unknown', 'unavailable', ''] %}\n  {% set start = start_time | as_datetime | as_local %}\n  {% set elapsed_minutes = ((now() - start).total_seconds() / 60) | int %}\n  {% set timeout_hours = states('input_number.extended_chore_timeout_hours') | float(6) %}\n  {% set timeout_minutes = (timeout_hours * 60) | int %}\n  {% set warning_minutes = timeout_minutes - 30 %}\n  {{ elapsed_minutes >= warning_minutes and elapsed_minutes < timeout_minutes }}\n{% else %}\n  false\n{% endif %}\n"
              }
            ],
