                "condition": "template",
                "value_template": "{% set start_time = states('input_datetime.extended_chore_start_charles') %} {% if start_time not in ['unknown', 'unavailable', ''] %}\n  {% set start = start_time | as_datetime | as_local %}\n  {% set elapsed_minutes = ((now() - start).total_seconds() / 60) | int %}\n  {% set timeout_hours = states('input_number.extended_chore_timeout_hours') | float(6) %}\n  {% set timeout_minutes = (timeout_hours * 60) | int %}\n  {{ elapsed_minutes >= timeout_minutes }}\n{% else %}\n  false\n{% endif %}\n"
              }
            ],
            "actions": [
              {
                "action": "input_number.set_value",
                "metadata": {},
                "data": {
                  "value": "{% set current = states('input_number.chore_minutes_charles') | float(0) %} {% set session = states('input_number.extended_session_minutes_charles') | float(0) %} {{ [0, current - session] | max }}\n"
                },
                "target": {
                  "entity_id": "input_number.chore_minutes_charles"
                }
              },
              {
                "action": "input_boolean.turn_off",
                "metadata": {},
                "data": {},
                "target": {
