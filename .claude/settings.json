{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/agent-tools/hooks/git-sync.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/agent-tools/hooks/memory-check.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/agent-tools/hooks/automode-check.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/agent-tools/hooks/version-check.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/agent-tools/hooks/gate-check.sh\""
          }
        ]
      }
    ]
  }
